# Build stage (amd64/x64 architecture only)
# syntax=docker/dockerfile:1
FROM --platform=linux/amd64 golang:1.24.4 AS builder

# Set non-interactive installation environment variable
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    libopus-dev \
    libopusfile-dev \
    pkg-config \
    libc++-dev \
    libc++abi-dev \
    g++

# Copy onnxruntime library files (x64 only)
COPY docker/lib/onnxruntime-linux-x64-1.21.0.tgz /tmp/

# Install ONNX Runtime (x64 architecture)
RUN echo "Installing ONNX Runtime for x64 architecture" && \
    cd /tmp && \
    if [ ! -f "onnxruntime-linux-x64-1.21.0.tgz" ]; then \
        echo "Error: ONNX Runtime file not found!" && \
        ls -la /tmp/*.tgz 2>/dev/null || echo "No .tgz files found" && \
        exit 1; \
    fi && \
    tar -xzf onnxruntime-linux-x64-1.21.0.tgz || (echo "Failed to extract ONNX Runtime" && exit 1) && \
    ONNX_DIR=$(ls -d onnxruntime-linux-x64-*/ 2>/dev/null | head -n1) && \
    if [ -z "${ONNX_DIR}" ]; then \
        echo "Error: Failed to find extracted ONNX Runtime directory" && \
        ls -la /tmp/ && \
        exit 1; \
    fi && \
    echo "Found ONNX Runtime directory: ${ONNX_DIR}" && \
    mkdir -p /usr/local/include/onnxruntime && \
    if [ ! -d "${ONNX_DIR}include" ]; then \
        echo "Error: ${ONNX_DIR}include directory not found" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}include/* /usr/local/include/onnxruntime/ && \
    if [ ! -d "${ONNX_DIR}lib" ]; then \
        echo "Error: ${ONNX_DIR}lib directory not found" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}lib/* /usr/local/lib/ && \
    rm -rf /tmp/onnxruntime* && \
    (ldconfig 2>&1 || echo "Warning: ldconfig failed, but continuing...")

# Set Go environment variables
ENV ONNXRUNTIME_DIR=/usr/local
ENV CGO_CFLAGS="-I${ONNXRUNTIME_DIR}/include/onnxruntime" 
ENV CGO_LDFLAGS="-L${ONNXRUNTIME_DIR}/lib -lonnxruntime"
ENV GOPROXY=https://goproxy.cn,direct
ENV CGO_ENABLED=1

# Create working directory and copy source code
WORKDIR /app
# First copy lib directory (contains ten-vad header files and library files, needed for cgo compilation)
COPY lib ./lib
COPY . .

# Verify asr_server submodule content is included in build context (CI should checkout with submodules: recursive)
RUN test -f asr_server/server/setup.go || (echo "ERROR: asr_server submodule content missing, voice_server/server package not found in build context. CI please ensure checkout uses submodules: recursive." && exit 1)

# Download Go modules
RUN go mod tidy

# Set CGO library path (for ten-vad)
ENV CGO_LDFLAGS="-L${ONNXRUNTIME_DIR}/lib -lonnxruntime -L/app/lib/ten-vad/lib/Linux/x64"
ENV CGO_CFLAGS="-I${ONNXRUNTIME_DIR}/include/onnxruntime -I/app/lib/ten-vad/include"

# Build main program
RUN go build -o /app/xiaozhi_server ./cmd/server/

# Runtime stage (amd64/x64 architecture only)
FROM --platform=linux/amd64 ubuntu:22.04

# Set non-interactive installation environment variable
ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies (minimal installation)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopus0 \
    libopusfile0 \
    libc++1 \
    libc++abi1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy onnxruntime library files (x64 only)
COPY docker/lib/onnxruntime-linux-x64-1.21.0.tgz /tmp/

# Install ONNX Runtime runtime (x64 architecture)
RUN echo "Installing ONNX Runtime for x64 architecture" && \
    cd /tmp && \
    if [ ! -f "onnxruntime-linux-x64-1.21.0.tgz" ]; then \
        echo "Error: ONNX Runtime file not found!" && \
        ls -la /tmp/*.tgz 2>/dev/null || echo "No .tgz files found" && \
        exit 1; \
    fi && \
    tar -xzf onnxruntime-linux-x64-1.21.0.tgz || (echo "Failed to extract ONNX Runtime" && exit 1) && \
    ONNX_DIR=$(ls -d onnxruntime-linux-x64-*/ 2>/dev/null | head -n1) && \
    if [ -z "${ONNX_DIR}" ]; then \
        echo "Error: Failed to find extracted ONNX Runtime directory" && \
        ls -la /tmp/ && \
        exit 1; \
    fi && \
    echo "Found ONNX Runtime directory: ${ONNX_DIR}" && \
    mkdir -p /usr/local/include/onnxruntime && \
    if [ ! -d "${ONNX_DIR}include" ]; then \
        echo "Error: ${ONNX_DIR}include directory not found" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}include/* /usr/local/include/onnxruntime/ && \
    if [ ! -d "${ONNX_DIR}lib" ]; then \
        echo "Error: ${ONNX_DIR}lib directory not found" && \
        ls -la "${ONNX_DIR}" && \
        exit 1; \
    fi && \
    cp -r ${ONNX_DIR}lib/* /usr/local/lib/ && \
    rm -rf /tmp/onnxruntime* && \
    (ldconfig 2>&1 || echo "Warning: ldconfig failed, but continuing...")

# Set ONNX Runtime environment variables
ENV ONNXRUNTIME_DIR=/usr/local
ENV CGO_CFLAGS="-I${ONNXRUNTIME_DIR}/include/onnxruntime" 
ENV CGO_LDFLAGS="-L${ONNXRUNTIME_DIR}/lib -lonnxruntime"

# Set working directory
WORKDIR /workspace

# Copy compiled binary from build stage
COPY --from=builder /app/xiaozhi_server /workspace/bin/xiaozhi_server
# Copy lib directory (contains ten-vad runtime libraries)
COPY --from=builder /app/lib /workspace/lib

# Create necessary directories
RUN mkdir -p /workspace/logs /workspace/config

# Set runtime library path (for ten-vad)
ENV LD_LIBRARY_PATH=/workspace/lib:/workspace/lib/ten-vad/lib/Linux/x64

# Expose ports: http/websocket:8989, udp:8990, mqtt: 1883,2883,8883
EXPOSE 8989 8990 1883 2883 8883

# Startup command
CMD ["bin/xiaozhi_server", "-c", "config/config.yaml"]
