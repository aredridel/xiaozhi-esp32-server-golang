# Use official Ubuntu image as base image
FROM hackers365/xiaozhi_golang_build:0.1 AS builder

WORKDIR /app
COPY . .
RUN go build -o /app/xiaozhi_server /app/cmd/server/  # Compile binary file

FROM ubuntu:22.04

# Set non-interactive installation environment variable
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends libopus0 libopusfile-dev libc++1 libc++abi1 && rm -rf /var/lib/apt/lists/*

COPY docker/lib/onnxruntime-linux-x64-1.21.0.tgz /tmp/
RUN cd /tmp && \
    tar -xzf onnxruntime-linux-x64-1.21.0.tgz && \
    mkdir -p /usr/local/include/onnxruntime && \
    cp -r onnxruntime-linux-x64-1.21.0/include/* /usr/local/include/onnxruntime/ && \
    cp -r onnxruntime-linux-x64-1.21.0/lib/* /usr/local/lib/ && \
    rm -rf onnxruntime-linux-x64-1.21.0* && \
    ldconfig
ENV ONNXRUNTIME_DIR=/usr/local
ENV CGO_CFLAGS="-I${ONNXRUNTIME_DIR}/include/onnxruntime" 
ENV CGO_LDFLAGS="-L${ONNXRUNTIME_DIR}/lib -lonnxruntime"

# Set working directory
WORKDIR /workspace

# Only copy compiled binary from build stage (without source code and build dependencies)
COPY --from=builder /app/xiaozhi_server /workspace/bin/xiaozhi_server
# Copy lib directory from build stage (contains ten-vad runtime libraries)
COPY --from=builder /app/lib /workspace/lib

RUN mkdir -p /workspace/logs /workspace/config

# Set runtime library path (for ten-vad)
ENV LD_LIBRARY_PATH=/workspace/lib:/workspace/lib/ten-vad/lib/Linux/x64 

# Expose ports: http/websocket:8989, udp:8990, mqtt: 1883,2883,8883, 
EXPOSE 8989 8990 1883 2883 8883

# Startup command
CMD ["bin/xiaozhi_server", "-c", "config/config.yaml"]
